PROJECT_SLUG=project-example

# Pin full image tags per project (match live/staging when migrating existing sites).
WORDPRESS_IMAGE=wordpress:php8.3-apache
MARIADB_IMAGE=mariadb:10

WP_PORT=8XXX
PMA_PORT=8XXX
MAILHOG_UI_PORT=8XXX
MAILHOG_SMTP_PORT=8XXX

WP_DB_NAME=wordpress
WP_DB_USER=wpuser
WP_DB_PASSWORD=change-me
WP_DB_ROOT_PASSWORD=change-root-me

# Table prefix (default wp_; set to live prefix when migrating, e.g. rs_)
WP_TABLE_PREFIX=wp_

# --- Migration (existing site import) ---
# MIGRATION_SOURCE_URL: keep it — also used as the live-site link in the local dev index.
# MIGRATION_SOURCE_URL=https://www.example.de

# Multisite (0=off, 1=on). Path-based = SUBDOMAIN 0; subdomain install = 1.
# DOMAIN_CURRENT_SITE is derived as localhost:<WP_PORT> in docker-compose.
# WP_MULTISITE=0
# WP_MULTISITE_SUBDOMAIN=0
