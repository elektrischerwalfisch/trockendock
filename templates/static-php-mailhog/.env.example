STACK=static-php-mailhog
PROJECT_SLUG=project-example

# Image pin — set by `static-stack project create` (--php or config/stack-defaults.env).
# Leave empty in the template: not a soft-default SSOT.
# Format: php:<x.y>-apache
# Hub: https://hub.docker.com/_/php/tags
PHP_IMAGE=

WEB_PORT=8XXX
MAILHOG_UI_PORT=8XXX
MAILHOG_SMTP_PORT=8XXX

# Live site link in the local dev index ($LOCAL_DEV_INDEX_FILE). Optional.
# MIGRATION_SOURCE_URL=https://www.example.de
