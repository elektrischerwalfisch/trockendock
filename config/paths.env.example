# Trockendock path configuration (copy to paths.env and adjust).
# paths.env is gitignored; scripts load paths.env or fall back to this file.
#
# cp config/paths.env.example config/paths.env

# Where customer/site projects live (docker-compose + .env per project)
WEBSITES_ROOT="${HOME}/Dokumente/00-Websites"

# This repository (public Trockendock platform)
TROCKENDOCK_ROOT="${HOME}/trockendock"
