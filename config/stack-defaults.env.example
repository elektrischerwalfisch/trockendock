# Trockendock operator stack image defaults (copy to stack-defaults.env and set pins).
# stack-defaults.env is gitignored. Create/menu use it only as soft defaults (Enter / omitted flags).
# If the local file is missing, create requires explicit pins — this example is never used as a version fallback.
#
# cp config/stack-defaults.env.example config/stack-defaults.env
#
# Prefixed keys avoid exporting WORDPRESS_IMAGE/PHP_IMAGE into the shell (Compose would override project .env).

# --- WordPress create ---
# Hub: https://hub.docker.com/_/wordpress/tags
# Format: wordpress:<WP>-php<PHP>-apache
# DEFAULT_WORDPRESS_IMAGE=

# Hub: https://hub.docker.com/_/mariadb/tags
# Format: mariadb:<x.y>  (prefer an explicit minor)
# DEFAULT_MARIADB_IMAGE=

# --- Static PHP create (static-php / static-php-mailhog) ---
# Hub: https://hub.docker.com/_/php/tags
# Format: php:<x.y>-apache
# DEFAULT_PHP_IMAGE=
